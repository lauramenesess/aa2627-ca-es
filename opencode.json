{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      "opencode.json": "ask",
      ".opencode/**": "ask"
    },
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "mkdir *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git remote*": "allow",
      "git add *": "allow",
      "git commit *": "allow"
    }
  }
}
