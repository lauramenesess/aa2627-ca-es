{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "AGENTS.md": "ask",
      "opencode.json": "ask",
      ".opencode/**": "ask"
    },
    "webfetch": "allow",
    "external_directory": {
      "*": "deny",
      "~/.local/share/opencode/tool-output/*": "allow",
      "~/.local/share/opencode/plans/*": "allow",
      "~/.opencode/plan/*": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "Get-Location": "allow",
      "Test-Path *": "allow",
      "cd *": "allow",
      "Set-Location *": "allow",
      "mkdir *": "allow",
      "New-Item -ItemType Directory *": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "Get-ChildItem *": "allow",
      "cat *": "allow",
      "type *": "allow",
      "Get-Content *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "Select-String *": "allow",
      "*:/*": "deny",
      "*:\\*": "deny",
      "*http://*": "ask",
      "*https://*": "ask",
      "*..*": "deny",
      "* /*": "deny",
      "* \\*": "deny",
      "*\"/*": "deny",
      "*\"\\*": "deny",
      "*'/*": "deny",
      "*'\\*": "deny",
      "*~*": "deny",
      "*$*": "deny",
      "*%*": "deny",
      "*opencode.json*": "deny",
      "*AGENTS.md*": "deny",
      "*.opencode*": "deny",
      "*.vscode*": "deny",
      "*.git*": "deny",
      "rm -*r*": "deny",
      "rm * -*r*": "deny",
      "Remove-Item -r*": "deny",
      "Remove-Item * -r*": "deny",
      "powershell*": "deny",
      "pwsh*": "deny",
      "cmd*": "deny",
      "bash*": "deny",
      "sh *": "deny",
      "Invoke-Expression*": "deny",
      "iex*": "deny",
      "Start-Process*": "deny",
      "git restore *": "ask",
      "git reset *": "ask",
      "git rm *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git stash*": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git revert *": "ask",
      "git config *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git diff --no-index*": "deny",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git rev-parse*": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git config user.name": "allow",
      "git config user.email": "allow",
      "git config --get *": "allow",
      "git add *": "allow",
      "git mv *": "allow",
      "git commit *": "allow",
      "git fetch*": "allow",
      "git pull": "allow",
      "git push *-f*": "deny",
      "git push": "allow",
      "git push origin main": "allow",
      "git push -u origin main": "allow"
    }
  }
}
